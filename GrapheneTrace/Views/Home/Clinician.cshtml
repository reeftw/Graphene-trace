@{
    ViewData["Title"] = "Graphene Trace Portal";
}

<div class="w-full bg-gray-50 min-h-screen">
    <header class="bg-white-100 border-b border-white-200">
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-4">
                <button id="sidebarToggle" class="p-2 rounded-md hover:bg-green-200">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <h1 class="text-2xl font-bold text-gray-900">Graphene Trace Portal</h1>
            </div>
            <div>
                <button class="p-2 rounded-full border border-green-300"><svg class="w-6 h-6 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 15c2.761 0 5.303.9 7.379 2.418M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg></button>
            </div>
        </div>
    </header>

    <div class="grid grid-cols-12 gap-6 p-6">
        
        <aside id="sidebar" class="col-span-3 bg-white rounded-lg shadow p-6 transition-all duration-300">
            <div class="mb-4">
                <input id="searchInput" type="text" placeholder="Search" class="w-full p-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            
            <nav class="space-y-4">
                <button class="w-full bg-blue-600 text-black py-3 px-4 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all text-left">New Patients</button>
                <button class="w-full bg-blue-600 text-black py-3 px-4 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all text-left">Edit Patients</button>
                <button class="w-full bg-blue-600 text-black py-3 px-4 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all text-left">Request Admin</button>
                <button class="w-full bg-blue-600 text-black py-3 px-4 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all text-left">Previous Comments</button>
            </nav>
        </aside>

        <main id="mainContent" class="col-span-9 transition-all duration-300">
            <h2 class="text-4xl font-extrabold text-gray-900 mb-6">Patients</h2>

            <div class="bg-white rounded-lg p-8 shadow-inner" style="min-height:420px;">
                
                <div id="patientList" class="">
                    <div class="text-gray-500">Loading patients...</div>
                </div>
            </div>
        </main>
    </div>

    <div id="heatmapModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
        <div class="bg-white rounded-xl p-6 max-w-2xl w-full mx-4">
            <div class="flex justify-between items-center mb-4">
                <h2 id="modalTitle" class="text-2xl font-semibold text-gray-800">Patient Heatmap</h2>
                <button onclick="closeHeatmapModal()" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>
            <div id="heatmapContainer"></div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    $(document).ready(function() {
        // Sidebar toggle logic
        $('#sidebarToggle').on('click', function() {
            $('#sidebar').toggleClass('hidden');
            $('#mainContent').toggleClass('col-span-9').toggleClass('col-span-12');
        });

        fetchPatientGroups();

        $('#searchInput').on('input', function() {
            const query = ($(this).val() || '').toLowerCase();
            renderPatients(patientDataCache.filter(p => 
                (p.patientId || '').toLowerCase().includes(query)
            ));
        });
    });

    let patientDataCache = [];

    function fetchPatientGroups() {
        $.get('/Home/GetPatientFilesMetadata')
            .done(function(data) {
                patientDataCache = normalizePatients(data || []);
                renderPatients(patientDataCache);
            })
            .fail(function() {
                $('#patientList').html('<div class="bg-red-50 p-6 rounded text-red-700 text-center">Failed to load data from backend.</div>');
            });
    }

    function normalizePatients(raw) {
        return raw.map(pg => {
            const patientId = pg.patientId || pg.PatientId || pg.storageId || pg.StorageId || '';
            const storageId = pg.storageId || pg.StorageId || patientId;
            const filesRaw = pg.files || pg.Files || [];
            const files = filesRaw.map(f => ({
                fileName: f.fileName || f.FileName || f.File || '',
                smallMatrix: f.smallMatrix || f.SmallMatrix || f.MiniMatrix || [],
                peakPressure: f.peakPressure || f.PeakPressure || f.Peak || 0,
                contactArea: f.contactArea || f.ContactArea || f.Contact || 0,
                isAlert: (typeof f.isAlert !== 'undefined') ? f.isAlert : (f.IsAlert || false)
            }));

            return { patientId, storageId, files };
        });
    }

    function renderPatients(patients) {
        const list = $('#patientList');
        list.empty();

        if (patients.length === 0) {
            list.append('<div class="text-center text-gray-500 p-8">No matching patients found.</div>');
            return;
        }

        patients.forEach(p => list.append(createPatientCard(p)));
    }

    function createPatientCard(patient) {
        const pid = patient.patientId || patient.storageId || '';
        
        const card = $('<div>').addClass('bg-white rounded-lg shadow mb-2');

        // Patient ID "button" (blue with shadow)
        const header = $('<div>')
            .addClass('cursor-pointer text-center py-3 px-4 font-medium text-black bg-#3fa4fc-600 hover:bg-#3fa4fc-700 rounded-lg shadow-md transition-all')
            .text(pid)
            .attr('role', 'button')
            .click(() => togglePatientDetails(pid));

        const details = $('<div>').attr('id', `details-${pid}`).addClass('mt-2 hidden p-4 border-t border-gray-200');

        card.append(header).append(details);
        return card;
    }

    function togglePatientDetails(patientId) {
        const detailsEl = $(`#details-${patientId}`);
        if (detailsEl.length === 0) return;

        const isAlreadyOpen = !detailsEl.hasClass('hidden');
        $('.patient-details-panel').not(detailsEl).addClass('hidden');

        if (isAlreadyOpen) {
            detailsEl.addClass('hidden');
        } else {
            const pg = patientDataCache.find(p => (p.patientId || p.storageId) === patientId);
            detailsEl.empty();
            if (!pg || !pg.files || pg.files.length === 0) {
                detailsEl.append('<div class="text-sm text-gray-600">No files found for this patient.</div>');
            } else {
                pg.files.forEach(f => detailsEl.append(createFileEntry(pg.storageId || pg.patientId, f)));
            }
            detailsEl.addClass('patient-details-panel'); 
            detailsEl.removeClass('hidden');
        }
    }

    function createFileEntry(patientStorageId, file) {
        const fname = file.fileName || file.FileName || '';
        const entry = $('<div>').addClass('border rounded-lg p-3 cursor-pointer hover:bg-gray-50 transition')
            .click(() => showHeatmap(patientStorageId, fname));

        const miniHeatmap = createMiniHeatmap(file.smallMatrix || file.SmallMatrix || []);
        const metrics = $('<div>').addClass('ml-4 flex-grow')
            .append($('<h4>').addClass('font-medium text-sm text-gray-900').text(fname))
            .append($('<p>').addClass('text-xs text-gray-600')
                .text(`Peak: ${file.peakPressure || file.PeakPressure || 0} mmHg | Area: ${file.contactArea || file.ContactArea || 0}%`));

        const row = $('<div>').addClass('flex items-start').append(miniHeatmap).append(metrics);
        entry.append(row);
        return entry;
    }

    function createMiniHeatmap(matrix) {
        const table = $('<table>').addClass('mini-heatmap-table').css({ width: '64px', height: '64px' });
        (matrix || []).forEach(row => {
            const tr = $('<tr>');
            (row || []).forEach(v => tr.append($('<td>').css({
                width: '8px',
                height: '8px',
                backgroundColor: getColor(v || 0)
            })));
            table.append(tr);
        });
        return table;
    }

    function getColor(v) {
        if (v < 20) return '#1e3a8a';
        if (v < 40) return '#2563eb';
        if (v < 60) return '#0ea5e9';
        if (v < 80) return '#14b8a6';
        if (v < 100) return '#84cc16';
        if (v < 150) return '#facc15';
        if (v < 200) return '#fb923c';
        return '#ef4444';
    }

    function showHeatmap(patientStorageId, fileName) {
        $('#modalTitle').text(`Pressure Map: ${fileName}`);
        $('#heatmapContainer').html('<div class="text-center text-indigo-600 py-6">Loading...</div>');
        $('#heatmapModal').removeClass('hidden');

        $.get(`/Home/GetHeatmapPartial?patientId=${patientStorageId}&fileName=${fileName}`)
            .done(data => $('#heatmapContainer').html(data))
            .fail(() => $('#heatmapContainer').html('<p class="text-red-600 text-center">Error loading heatmap.</p>'));
    }

    function closeHeatmapModal() {
        $('#heatmapModal').addClass('hidden');
        $('#heatmapContainer').empty();
    }
</script>
}