@{
    ViewData["Title"] = "Graphene Trace Portal";
}

<div class="w-full bg-gray-50 min-h-screen">
    <header class="bg-white-100 border-b border-white-200">
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-4">
                <button id="sidebarToggle" class="p-2 rounded-md hover:bg-green-200">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <h1 class="text-2xl font-bold text-gray-900">Graphene Trace Portal</h1>
            </div>
            <div>
                <button class="p-2 rounded-full border border-green-300"><svg class="w-6 h-6 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 15c2.761 0 5.303.9 7.379 2.418M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg></button>
            </div>
        </div>
    </header>

    <div class="grid grid-cols-12 gap-6 p-6">
        
        <aside id="sidebar" class="col-span-3 bg-white rounded-lg shadow p-6 transition-all duration-300">
            <div class="mb-4">
                <input id="searchInput" type="text" placeholder="Search" class="w-full p-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            
            <nav class="space-y-4">
                <button class="w-full bg-blue-600 text-black py-3 px-4 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all text-left">New Patients</button>
                <button class="w-full bg-blue-600 text-black py-3 px-4 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all text-left">Edit Patients</button>
                <!-- MODIFIED: Added id="adminRequestBtn" to this button -->
                <button id="adminRequestBtn" class="w-full bg-blue-600 text-black py-3 px-4 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all text-left">Request Admin</button>
                <button id="prevCommentsButton" class="w-full bg-blue-600 text-black py-3 px-4 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all text-left">Previous Comments</button>
            </nav>
        </aside>

        <main id="mainContent" class="col-span-9 transition-all duration-300">
            <h2 class="text-4xl font-extrabold text-gray-900 mb-6">Patients</h2>

            <div class="bg-white rounded-lg p-8 shadow-inner" style="min-height:420px;">
                
                <div id="patientList" class="">
                    <div class="text-gray-500">Loading patients...</div>
                </div>
            </div>
        </main>
    </div>

    <!-- Heatmap Modal -->
    <div id="heatmapModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
        <div class="bg-white rounded-xl p-6 max-w-2xl w-full mx-4">
            <div class="flex justify-between items-center mb-4">
                <h2 id="modalTitle" class="text-2xl font-semibold text-gray-800">Patient Heatmap</h2>
                <button onclick="closeHeatmapModal()" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>
            
            <div id="heatmapContainer"></div>

            <div class="mt-6 border-t pt-4">
                <label for="commentTextArea" class="block text-sm font-medium text-gray-700">Add a Comment</label>
                <textarea id="commentTextArea" rows="3" class="w-full p-2 mt-1 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
                
                <div class="flex justify-between items-center mt-2">
                    <div id="commentStatus" class="text-sm"></div>
                    <button id="saveCommentButton" class="bg-blue-600 text-white py-2 px-5 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all">
                        Save Comment
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Previous Comments Modal -->
    <div id="commentsModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
        <div class="bg-white rounded-xl p-6 max-w-4xl w-full mx-4" style="max-height: 80vh; display: flex; flex-direction: column;">
            <div class="flex justify-between items-center mb-4 flex-shrink-0">
                <h2 class="text-2xl font-semibold text-gray-800">All Previous Comments</h2>
                <button onclick="closeCommentsModal()" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>
            
            <div id="commentsContainer" class="overflow-y-auto">
                </div>
        </div>
    </div>

    <!-- NEW: Admin Request Modal (copied from Admin.cshtml) -->
    <div id="adminModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 hidden z-50">
        <div class="bg-white rounded-lg shadow-2xl max-w-md w-full">
            
            <!-- Modal Header -->
            <div class="flex justify-between items-center p-4 border-b">
                <h3 class="text-xl font-semibold text-gray-800">New Admin Request</h3>
                <button id="closeModalBtn" class="text-gray-500 hover:text-gray-800 text-2xl">&times;</button>
            </div>

            <!-- Modal Body (The Form) -->
            <form id="adminRequestForm" class="p-6">
                <div class="mb-4">
                    <label for="userId" class="block text-sm font-medium text-gray-700 mb-1">Patient/Clinician ID</label>
                    <input type="text" id="userId" name="userId" placeholder="Enter ID (e.g., P12345)" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                </div>

                <div class="mb-4">
                    <label for="comment" class="block text-sm font-medium text-gray-700 mb-1">Reason for Request</label>
                    <textarea id="comment" name="comment" rows="4" placeholder="Please provide a reason for this request..." class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"></textarea>
                </div>

                <!-- Feedback Messages -->
                <div id="successMessage" class="hidden text-sm text-green-600 p-3 bg-green-50 rounded-md mb-4"></div>
                <div id="errorMessage" class="hidden text-sm text-red-600 p-3 bg-red-50 rounded-md mb-4"></div>

                <!-- Modal Footer (Buttons) -->
                <div class="flex justify-end space-x-3">
                    <button type="button" id="cancelBtn" class="px-5 py-2 rounded-md text-gray-700 bg-gray-100 hover:bg-gray-200 border border-gray-300">
                        Cancel
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-md text-white bg-green-600 hover:bg-green-700">
                        Submit Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    $(document).ready(function() {
        // Sidebar toggle logic
        $('#sidebarToggle').on('click', function() {
            $('#sidebar').toggleClass('hidden');
            $('#mainContent').toggleClass('col-span-9').toggleClass('col-span-12');
        });

        fetchPatientGroups();

        $('#searchInput').on('input', function() {
            const query = ($(this).val() || '').toLowerCase();
            renderPatients(patientDataCache.filter(p => 
                (p.patientId || '').toLowerCase().includes(query)
            ));
        });

        $('#saveCommentButton').on('click', function() {
            const commentText = $('#commentTextArea').val();
            const patientId = $('#heatmapModal').data('patientId');
            const fileName = $('#heatmapModal').data('fileName');
            const statusEl = $('#commentStatus');

            if (!commentText) {
                statusEl.text('Comment cannot be empty.').attr('class', 'text-sm text-red-600');
                return;
            }
            statusEl.text('Saving...').attr('class', 'text-sm text-gray-600');

            $.post('/Home/SaveComment', { patientId: patientId, fileName: fileName, comment: commentText })
                .done(function() {
                    statusEl.text('Comment saved!').attr('class', 'text-sm text-green-600');
                    $('#commentTextArea').val('');
                })
                .fail(function() {
                    statusEl.text('Failed to save comment.').attr('class', 'text-sm text-red-600');
                });
        });

        // Previous Comments button logic
        $('#prevCommentsButton').on('click', function() {
            showCommentsModal();
        });

        // --- NEW: Admin Request Modal Logic (jQuery version) ---

        const adminModal = $('#adminModal');
        const adminRequestForm = $('#adminRequestForm');
        const successMessage = $('#successMessage');
        const errorMessage = $('#errorMessage');

        function showAdminModal() {
            adminModal.removeClass('hidden');
            successMessage.addClass('hidden');
            errorMessage.addClass('hidden');
            adminRequestForm[0].reset();
        }

        function hideAdminModal() {
            adminModal.addClass('hidden');
        }

        // --- Event Listeners for Admin Modal ---
        $('#adminRequestBtn').on('click', showAdminModal);
        $('#closeModalBtn').on('click', hideAdminModal);
        $('#cancelBtn').on('click', hideAdminModal);
        
        adminModal.on('click', function(e) {
            // Hide if backdrop is clicked
            if (e.target === adminModal[0]) {
                hideAdminModal();
            }
        });

        adminRequestForm.on('submit', async function(e) {
            e.preventDefault();
            
            const userId = $('#userId').val();
            const comment = $('#comment').val();

            if (!userId || !comment) {
                errorMessage.text('Please fill out both the ID and the reason.').removeClass('hidden');
                successMessage.addClass('hidden');
                return;
            }

            const submitButton = $(this).find('button[type="submit"]');
            submitButton.prop('disabled', true).text('Submitting...');
            errorMessage.addClass('hidden');

            try {
                // This points to the action in HomeController
                const response = await fetch('/Home/SubmitAdminRequest', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ UserId: userId, Comment: comment })
                });

                if (response.ok) {
                    successMessage.text('Request submitted successfully!').removeClass('hidden');
                    setTimeout(hideAdminModal, 2000);
                } else {
                    const errorData = await response.json();
                    errorMessage.text(`Error: ${errorData.message || 'Could not submit request.'}`).removeClass('hidden');
                }
            } catch (error) {
                errorMessage.text(`Network error: ${error.message}`).removeClass('hidden');
            } finally {
                submitButton.prop('disabled', false).text('Submit Request');
            }
        });

    }); // <-- End of $(document).ready()

    let patientDataCache = [];

    function fetchPatientGroups() {
        $.get('/Home/GetPatientFilesMetadata')
            .done(function(data) {
                patientDataCache = normalizePatients(data || []);
                renderPatients(patientDataCache);
            })
            .fail(function() {
                $('#patientList').html('<div class="bg-red-50 p-6 rounded text-red-700 text-center">Failed to load data from backend.</div>');
            });
    }

    function normalizePatients(raw) {
        return raw.map(pg => {
            const patientId = pg.patientId || pg.PatientId || pg.storageId || pg.StorageId || '';
            const storageId = pg.storageId || pg.StorageId || patientId;
            const filesRaw = pg.files || pg.Files || [];
            const files = filesRaw.map(f => ({
                fileName: f.fileName || f.FileName || f.File || '',
                smallMatrix: f.smallMatrix || f.SmallMatrix || f.MiniMatrix || [],
                peakPressure: f.peakPressure || f.PeakPressure || f.Peak || 0,
                contactArea: f.contactArea || f.ContactArea || f.Contact || 0,
                isAlert: (typeof f.isAlert !== 'undefined') ? f.isAlert : (f.IsAlert || false)
            }));

            return { patientId, storageId, files };
        });
    }

    function renderPatients(patients) {
        const list = $('#patientList');
        list.empty();
        if (patients.length === 0) {
            list.append('<div class="text-center text-gray-500 p-8">No matching patients found.</div>');
            return;
        }
        patients.forEach(p => list.append(createPatientCard(p)));
    }

    function createPatientCard(patient) {
        const pid = patient.patientId || patient.storageId || '';
        const card = $('<div>').addClass('bg-white rounded-lg shadow mb-2');
        const header = $('<div>')
            .addClass('cursor-pointer text-center py-3 px-4 font-medium text-black bg-#3fa4fc-600 hover:bg-#3fa4fc-700 rounded-lg shadow-md transition-all')
            .text(pid)
            .attr('role', 'button')
            .click(() => togglePatientDetails(pid));
        const details = $('<div>').attr('id', `details-${pid}`).addClass('mt-2 hidden p-4 border-t border-gray-200');
        card.append(header).append(details);
        return card;
    }

    function togglePatientDetails(patientId) {
        const detailsEl = $(`#details-${patientId}`);
        if (detailsEl.length === 0) return;
        const isAlreadyOpen = !detailsEl.hasClass('hidden');
        $('.patient-details-panel').not(detailsEl).addClass('hidden');

        if (isAlreadyOpen) {
            detailsEl.addClass('hidden');
        } else {
            const pg = patientDataCache.find(p => (p.patientId || p.storageId) === patientId);
            detailsEl.empty();
            if (!pg || !pg.files || pg.files.length === 0) {
                detailsEl.append('<div class="text-sm text-gray-600">No files found for this patient.</div>');
            } else {
                pg.files.forEach(f => detailsEl.append(createFileEntry(pg.storageId || pg.patientId, f)));
            }
            detailsEl.addClass('patient-details-panel'); 
            detailsEl.removeClass('hidden');
        }
    }

    function createFileEntry(patientStorageId, file) {
        const fname = file.fileName || file.FileName || '';
        const entry = $('<div>').addClass('border rounded-lg p-3 cursor-pointer hover:bg-gray-50 transition')
            .click(() => showHeatmap(patientStorageId, fname));
        const miniHeatmap = createMiniHeatmap(file.smallMatrix || file.SmallMatrix || []);
        const metrics = $('<div>').addClass('ml-4 flex-grow')
            .append($('<h4>').addClass('font-medium text-sm text-gray-900').text(fname))
            .append($('<p>').addClass('text-xs text-gray-600')
                .text(`Peak: ${file.peakPressure || file.PeakPressure || 0} mmHg | Area: ${file.contactArea || file.ContactArea || 0}%`));
        const row = $('<div>').addClass('flex items-start').append(miniHeatmap).append(metrics);
        entry.append(row);
        return entry;
    }

    function createMiniHeatmap(matrix) {
        const table = $('<table>').addClass('mini-heatmap-table').css({ width: '64px', height: '64px' });
        (matrix || []).forEach(row => {
            const tr = $('<tr>');
            (row || []).forEach(v => tr.append($('<td>').css({
                width: '8px',
                height: '8px',
                backgroundColor: getColor(v || 0)
            })));
            table.append(tr);
        });
        return table;
    }

    function getColor(v) {
        if (v < 20) return '#1e3a8a';
        if (v < 40) return '#2563eb';
        if (v < 60) return '#0ea5e9';
        if (v < 80) return '#14b8a6';
        if (v < 100) return '#84cc16';
        if (v < 150) return '#facc15';
        if (v < 200) return '#fb923c';
        return '#ef4444';
    }

    function showHeatmap(patientStorageId, fileName) {
        $('#modalTitle').text(`Pressure Map: ${fileName}`);
        $('#heatmapContainer').html('<div class="text-center text-indigo-600 py-6">Loading...</div>');
        $('#heatmapModal').removeClass('hidden');
        $('#heatmapModal').data('patientId', patientStorageId);
        $('#heatmapModal').data('fileName', fileName);

        $.get(`/Home/GetHeatmapPartial?patientId=${patientStorageId}&fileName=${fileName}`)
            .done(data => $('#heatmapContainer').html(data))
            .fail(() => $('#heatmapContainer').html('<p class="text-red-600 text-center">Error loading heatmap.</p>'));
    }

    function closeHeatmapModal() {
        $('#heatmapModal').addClass('hidden');
        $('#heatmapContainer').empty();
        $('#commentTextArea').val('');
        $('#commentStatus').empty().attr('class', 'text-sm');
        $('#heatmapModal').removeData('patientId').removeData('fileName');
    }

    // --- FUNCTIONS FOR COMMENTS MODAL ---

    function showCommentsModal() {
        const container = $('#commentsContainer');
        container.html('<div class="text-center text-indigo-600 py-6">Loading all comments...</div>');
        $('#commentsModal').removeClass('hidden');

        $.get('/Home/GetAllComments')
            .done(function(comments) {
                renderComments(comments);
            })
            .fail(function() {
                container.html('<p class="text-red-600 text-center">Error loading comments.</p>');
            });
    }

    function closeCommentsModal() {
        $('#commentsModal').addClass('hidden');
        $('#commentsContainer').empty();
    }

    function renderComments(comments) {
        const container = $('#commentsContainer');
        container.empty();

        if (!comments || comments.length === 0) {
            container.html('<div class="text-center text-gray-500 p-8">No comments found.</div>');
            return;
        }

        // comments are already sorted by the server (newest first)
        comments.forEach(comment => {
            const date = new Date(comment.timestamp).toLocaleString();

            const entry = $('<div>').addClass('border-b border-gray-200 p-4');
            
            const header = $('<div>').addClass('flex justify-between items-center text-sm mb-2');
            header.append($('<strong>').addClass('text-indigo-700').text(`Patient: ${comment.patientId}`));
            header.append($('<span>').addClass('text-gray-500').text(date));

            const file = $('<div>').addClass('text-sm text-gray-600 mb-2').text(`File: ${comment.fileName}`);
            const text = $('<p>').addClass('text-gray-800').text(comment.comment);

            entry.append(header).append(file).append(text);
            container.append(entry);
        });
    }

</script>
}