@{
    ViewData["Title"] = "Graphene Trace Portal";
}

<div class="w-full bg-gray-50 min-h-screen">
    <header class="bg-white-100 border-b border-white-200">
        <div class="flex items-center justify-between px-4 py-3">
            
            <!-- LEFT SIDE -->
            <div class="flex items-center gap-4">
                <button id="sidebarToggle" class="p-2 rounded-md hover:bg-green-200">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
                <h1 class="text-2xl font-bold text-gray-900">Graphene Trace Portal</h1>
            </div>

            <!-- RIGHT SIDE (PROFILE) -->
            <div class="relative">
                <button id="profileBtn" class="p-2 rounded-full border border-green-300 hover:bg-green-100 transition">
                    <svg class="w-6 h-6 text-green-700" fill="none" stroke="#1f2937" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M5.121 17.804A13.937 13.937 0 0112 15c2.761 0 5.303.9 7.379 2.418M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                </button>

                <!-- PROFILE MENU -->
                <div id="profileMenu"
                    class="absolute right-0 mt-2 w-48 bg-white border border-gray-200 rounded-lg shadow-lg hidden z-50">
                    
                    <div class="px-4 py-3 border-b text-sm text-gray-700">
                        <p class="font-semibold">Clinician ID</p>
                        <p class="text-indigo-600">CLN0009</p>
                    </div>

                    <button id="toggleDarkMode"
                            class="w-full text-left px-4 py-3 text-gray-800 hover:bg-gray-100 text-sm font-medium border-b">
                        Enable Dark Mode
                    </button>

                    <button id="signOutBtn"
                            class="w-full text-left px-4 py-3 text-red-600 hover:bg-red-50 text-sm font-medium">
                        Sign Out
                    </button>
                </div>
            </div>

        </div>
    </header>

    <!-- MAIN GRID -->
    <div class="grid grid-cols-12 gap-6 p-6">
        
        <!-- SIDEBAR -->
        <aside id="sidebar" class="col-span-3 bg-white rounded-lg shadow p-6 transition-all duration-300">
            <div class="mb-4">
                <input id="searchInput" type="text" placeholder="Search" 
                class="w-full p-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>

            <nav class="space-y-4">
                
                
                <button id="adminRequestBtn"
                        class="w-full bg-blue-600 text-black py-3 px-4 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all text-left">
                    Request Admin
                </button>

                <button id="prevCommentsButton"
                        class="w-full bg-blue-600 text-black py-3 px-4 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all text-left">
                    Previous Comments
                </button>

                <button id="sendMedsButton"
                        class="w-full bg-blue-600 text-black py-3 px-4 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all text-left">
                    Send Medications
                </button>
            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <main id="mainContent" class="col-span-9 transition-all duration-300">
            <h2 class="text-4xl font-extrabold text-gray-900 mb-6">Patients</h2>

            <div class="bg-white rounded-lg p-8 shadow-inner" style="min-height:420px;">
                <div id="patientList">
                    <div class="text-gray-500">Loading patients...</div>
                </div>
            </div>
        </main>
    </div>

    <!-- HEATMAP MODAL -->
    <div id="heatmapModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
        <div class="bg-white rounded-xl p-6 max-w-2xl w-full mx-4">
            <div class="flex justify-between items-center mb-4">
                <h2 id="modalTitle" class="text-2xl font-semibold text-gray-800">Patient Heatmap</h2>
                <button onclick="closeHeatmapModal()" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>
            
            <div id="heatmapModalBody"></div>

            <div class="mt-6 border-t pt-4">
                <label for="commentTextArea" class="block text-sm font-medium text-gray-700">Add a Comment</label>
                <textarea id="commentTextArea" rows="3" class="w-full p-2 mt-1 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
                
                <div class="flex justify-between items-center mt-2">
                    <div id="commentStatus" class="text-sm"></div>
                    <button id="saveCommentButton" class="bg-blue-600 text-white py-2 px-5 rounded-lg hover:bg-blue-700 shadow-md hover:shadow-lg transition-all">
                        Save Comment
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- PREVIOUS COMMENTS MODAL -->
    <div id="commentsModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
        <div class="bg-white rounded-xl p-6 max-w-4xl w-full mx-4" style="max-height:80vh; display:flex; flex-direction:column;">
            <div class="flex justify-between items-center mb-4 flex-shrink-0">
                <h2 class="text-2xl font-semibold text-gray-800">All Previous Comments</h2>
                <button onclick="closeCommentsModal()" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>
            
            <div id="commentsContainer" class="overflow-y-auto"></div>
        </div>
    </div>

    <!-- ADMIN REQUEST MODAL -->
    <div id="adminModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 hidden z-50">
        <div class="bg-white rounded-lg shadow-2xl max-w-md w-full">

            <div class="flex justify-between items-center p-4 border-b">
                <h3 class="text-xl font-semibold text-gray-800">New Admin Request</h3>
                <button id="closeModalBtn" class="text-gray-500 hover:text-gray-800 text-2xl">&times;</button>
            </div>

            <form id="adminRequestForm" class="p-6">
                <div class="mb-4">
                    <label for="userId" class="block text-sm font-medium text-gray-700 mb-1">Patient/Clinician ID</label>
                    <input type="text" id="userId" name="userId" placeholder="Enter ID (e.g., P12345)"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                </div>

                <div class="mb-4">
                    <label for="comment" class="block text-sm font-medium text-gray-700 mb-1">Reason for Request</label>
                    <textarea id="comment" name="comment" rows="4"
                        placeholder="Please provide a reason for this request..."
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"></textarea>
                </div>

                <div id="successMessage" class="hidden text-sm text-green-600 p-3 bg-green-50 rounded-md mb-4"></div>
                <div id="errorMessage" class="hidden text-sm text-red-600 p-3 bg-red-50 rounded-md mb-4"></div>

                <div class="flex justify-end space-x-3">
                    <button type="button" id="cancelBtn"
                        class="px-5 py-2 rounded-md text-gray-700 bg-gray-100 hover:bg-gray-200 border border-gray-300">
                        Cancel
                    </button>
                    <button type="submit"
                        class="px-5 py-2 rounded-md text-white bg-green-600 hover:bg-green-700">
                        Submit Request
                    </button>
                </div>
            </form>

        </div>
    </div>

    <!-- MEDICATIONS MODAL -->
    <div id="medsModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 hidden z-50">
        <div class="bg-white rounded-lg shadow-2xl max-w-md w-full">
            <div class="flex justify-between items-center p-4 border-b">
                <h3 class="text-xl font-semibold text-gray-800">Send Medications</h3>
                <button id="closeMedsModal" class="text-gray-500 hover:text-gray-800 text-2xl">&times;</button>
            </div>

            <form id="medsForm" class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="medPatientSelect">Select patient</label>
                    <select id="medPatientSelect"
                            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                        <option value="">Loading patients...</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="medPatientIdInput">Or enter patient ID</label>
                    <input id="medPatientIdInput" type="text" placeholder="e.g., 1c0fd777"
                           class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="medTextArea">Medications</label>
                    <textarea id="medTextArea" rows="4" placeholder="List medications and instructions..."
                              class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"></textarea>
                </div>

                <div id="medsSuccess" class="hidden text-sm text-green-600 p-3 bg-green-50 rounded-md"></div>
                <div id="medsError" class="hidden text-sm text-red-600 p-3 bg-red-50 rounded-md"></div>

                <div class="flex justify-end space-x-3">
                    <button type="button" id="cancelMedsBtn"
                            class="px-5 py-2 rounded-md text-gray-700 bg-gray-100 hover:bg-gray-200 border border-gray-300">
                        Cancel
                    </button>
                    <button type="submit"
                            class="px-5 py-2 rounded-md text-white bg-blue-600 hover:bg-blue-700">
                        Send
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>

body.dark-mode { background-color: #0b1220; color: #e5e7eb; }
body.dark-mode .bg-white, body.dark-mode .bg-white-100, body.dark-mode .bg-gray-50 { background-color: #0f172a !important; color: #e5e7eb; }
body.dark-mode .text-gray-900, body.dark-mode .text-gray-800, body.dark-mode .text-gray-700, body.dark-mode .text-gray-600, body.dark-mode .text-gray-500 { color: #e5e7eb !important; }
body.dark-mode .border, body.dark-mode .border-gray-200, body.dark-mode .border-gray-300, body.dark-mode .border-gray-100 { border-color: #1e293b !important; }
body.dark-mode .shadow-inner, body.dark-mode .shadow, body.dark-mode .shadow-md, body.dark-mode .shadow-lg { box-shadow: none !important; }
body.dark-mode button.bg-blue-600 { background-color: #1f2937 !important; color: #e5e7eb !important; border: 1px solid #334155; }
body.dark-mode button.hover\:bg-blue-700:hover { background-color: #0b1220 !important; }
body.dark-mode .rounded-lg, body.dark-mode .rounded-xl { background-color: #0f172a; }
body.dark-mode .bg-red-50 { background-color: #2f1b1b !important; }
body.dark-mode .bg-green-50 { background-color: #1b2f1f !important; }
body.dark-mode .bg-emerald-100, body.dark-mode .bg-red-100 { background-color: #1f2937 !important; color: #e5e7eb !important; }
body.dark-mode .text-emerald-700, body.dark-mode .text-red-700 { color: #e5e7eb !important; }
body.dark-mode input, body.dark-mode textarea, body.dark-mode select { background-color: #0b1220; color: #e5e7eb; border-color: #1f2937; }
body.dark-mode .bg-black { background-color: #000 !important; }
body.dark-mode #heatmapModal .bg-white { background-color: #0f172a !important; }
body.dark-mode #heatmapModal h2, body.dark-mode #heatmapModal p, body.dark-mode #heatmapModal span { color: #e5e7eb !important; }
body.dark-mode #heatmapModal table td { border-color: #1e293b !important; }
body.dark-mode #heatmapModal .text-gray-500 { color: #cbd5e1 !important; }
body.dark-mode #heatmapModal .bg-gray-50 { background-color: #0b1220 !important; }
</style>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script>
$(document).ready(function () {

    const clinicianId = 'CLN0009';
    const darkKey = 'gt-dark-mode';
    applyDarkMode(localStorage.getItem(darkKey) === '1');
    
    // PROFILE POPUP
    
    $('#profileBtn').on('click', function () {
        $('#profileMenu').toggleClass('hidden');
    });

    $(document).on('click', function (e) {
        if (!$(e.target).closest('#profileBtn').length &&
            !$(e.target).closest('#profileMenu').length) {
            $('#profileMenu').addClass('hidden');
        }
    });

    // SIGN OUT REDIRECT
    $('#signOutBtn').on('click', function () {
        window.location.href = '/Home/Index';
    });

    // SIDEBAR TOGGLE
    $('#sidebarToggle').on('click', function () {
        $('#sidebar').toggleClass('hidden');
        $('#mainContent').toggleClass('col-span-9 col-span-12');
    });

    fetchPatientGroups();

    $('#searchInput').on('input', function () {
        const query = ($(this).val() || '').toLowerCase();
        renderPatients(patientDataCache.filter(p =>
            (p.patientId || '').toLowerCase().includes(query)
        ));
    });

    $('#prevCommentsButton').on('click', function () {
        showCommentsModal();
    });

    $('#adminRequestBtn').on('click', function () {
        $('#adminModal').removeClass('hidden');
    });

    $('#toggleDarkMode').on('click', function () {
        const enabled = !$('body').hasClass('dark-mode');
        applyDarkMode(enabled);
        localStorage.setItem(darkKey, enabled ? '1' : '0');
    });

    $('#closeModalBtn, #cancelBtn').on('click', function () {
        $('#adminModal').addClass('hidden');
    });

    $('#adminModal').on('click', function (e) {
        if (e.target === this) $('#adminModal').addClass('hidden');
    });

    $('#adminRequestForm').on('submit', async function (e) {
        e.preventDefault();

        const userId = $('#userId').val();
        const comment = $('#comment').val();

        if (!userId || !comment) {
            $('#errorMessage').text('Please fill out all fields.').removeClass('hidden');
            return;
        }

        $('#successMessage').text('Request submitted!').removeClass('hidden');
        setTimeout(() => $('#adminModal').addClass('hidden'), 1500);
    });

    $('#sendMedsButton').on('click', function () {
        populateMedPatientsSelect();
        $('#medPatientIdInput').val(selectedPatientId || '');
        $('#medTextArea').val('');
        $('#medsSuccess, #medsError').addClass('hidden').text('');
        $('#medsModal').removeClass('hidden');
    });

    $('#medsModal').on('click', function (e) {
        if (e.target === this) hideMedsModal();
    });

    $('#closeMedsModal, #cancelMedsBtn').on('click', function () {
        hideMedsModal();
    });

    $('#medPatientSelect').on('change', function () {
        const val = $(this).val();
        if (val) $('#medPatientIdInput').val(val);
    });

    $('#medsForm').on('submit', function (e) {
        e.preventDefault();

        const patientId = (($('#medPatientIdInput').val() || $('#medPatientSelect').val() || '').trim()).toLowerCase();
        const medText = ($('#medTextArea').val() || '').trim();

        $('#medsSuccess, #medsError').addClass('hidden').text('');

        if (!patientId || !medText) {
            $('#medsError').text('Patient ID and medications are required.').removeClass('hidden');
            return;
        }

        $.post('/Home/SaveMedication', {
            patientId: patientId,
            medicationText: medText,
            clinicianId: clinicianId
        })
        .done(function () {
            $('#medsSuccess').text('Medications sent and saved.').removeClass('hidden');
            setTimeout(() => {
                hideMedsModal();
                $('#medsForm')[0].reset();
            }, 1200);
        })
        .fail(function () {
            $('#medsError').text('Failed to send medications. Try again.').removeClass('hidden');
        });
    });

    $('#patientList').on('click', '.viewHeatmapBtn', function () {
        const patientId = $(this).data('patientId');
        const fileName = $(this).data('fileName');
        openHeatmap(patientId, fileName);
    });

    $('#patientList').on('click', '.commentBtn', function () {
        const patientId = $(this).data('patientId');
        const fileName = $(this).data('fileName');
        openHeatmap(patientId, fileName);
        $('#commentTextArea').focus();
    });

    $('#heatmapModal').on('click', function (e) {
        if (e.target === this) closeHeatmapModal();
    });

    $('#commentsModal').on('click', function (e) {
        if (e.target === this) closeCommentsModal();
    });

    $('#saveCommentButton').on('click', function () {
        const comment = ($('#commentTextArea').val() || '').trim();
        if (!selectedPatientId || !selectedFileName) {
            setCommentStatus('Open a patient file before saving a comment.', true);
            return;
        }
        if (!comment) {
            setCommentStatus('Please enter a comment.', true);
            return;
        }

        setCommentStatus('Saving comment...', false);
        $.post('/Home/SaveComment', {
            patientId: selectedPatientId,
            fileName: selectedFileName,
            comment: comment
        })
            .done(function () {
                $('#commentTextArea').val('');
                setCommentStatus('Comment saved.', false);
            })
            .fail(function () {
                setCommentStatus('Failed to save comment. Try again.', true);
            });
    });

}); // END DOCUMENT READY

let patientDataCache = [];
let selectedPatientId = '';
let selectedFileName = '';

function fetchPatientGroups() {
    $('#patientList').html('<div class="text-gray-500">Loading patients...</div>');

    $.get('/Home/GetPatientFilesMetadata')
        .done(function (data) {
            patientDataCache = normalizePatients(data || []);
            renderPatients(patientDataCache);
            populateMedPatientsSelect();
        })
        .fail(function () {
            $('#patientList').html('<div class="bg-red-50 p-6 rounded text-red-700 text-center">Failed to load data.</div>');
        });
}

function normalizePatients(raw) {
    if (!Array.isArray(raw)) return [];

    return raw
        .map(group => {
            const patientId = group.patientId || group.PatientId || '';
            const filesRaw = group.files || group.Files || [];
            const files = Array.isArray(filesRaw) ? filesRaw : [];

            const normalizedFiles = files
                .map(file => ({
                    fileName: file.fileName || file.FileName || '',
                    peakPressure: Number(file.peakPressure ?? file.PeakPressure ?? 0),
                    contactArea: Number(file.contactArea ?? file.ContactArea ?? 0),
                    isAlert: Boolean(file.isAlert ?? file.IsAlert),
                    smallMatrix: file.smallMatrix || file.SmallMatrix || []
                }))
                .filter(f => f.fileName);

            normalizedFiles.sort((a, b) => b.fileName.localeCompare(a.fileName));

            return {
                patientId: patientId,
                files: normalizedFiles
            };
        })
        .filter(g => g.patientId && g.files.length > 0)
        .sort((a, b) => a.patientId.localeCompare(b.patientId));
}

function renderPatients(patients) {
    if (!patients.length) {
        $('#patientList').html('<div class="text-gray-500">No patients found.</div>');
        return;
    }

    const html = patients.map(renderPatientGroup).join('');
    $('#patientList').html(html);
}

function renderPatientGroup(group) {
    const filesHtml = group.files.map(file => renderFileCard(group.patientId, file)).join('');
    const fileCountLabel = group.files.length === 1 ? '1 file' : `${group.files.length} files`;

    return `
        <div class="mb-6 border border-gray-200 rounded-xl bg-white shadow-sm">
            <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
                <div>
                    <p class="text-xs uppercase text-gray-500 tracking-wide">Patient</p>
                    <p class="text-lg font-semibold text-gray-900">${group.patientId}</p>
                </div>
                <span class="text-sm text-gray-600">${fileCountLabel}</span>
            </div>
            <div class="grid gap-4 p-4 lg:grid-cols-2">
                ${filesHtml}
            </div>
        </div>
    `;
}

function renderFileCard(patientId, file) {
    const badge = file.isAlert
        ? '<span class="px-2 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-full">Alert</span>'
        : '<span class="px-2 py-1 text-xs font-semibold bg-emerald-100 text-emerald-700 rounded-full">Nominal</span>';

    return `
        <div class="bg-gray-50 border border-gray-100 rounded-lg p-4 flex flex-col gap-3 shadow">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <p class="text-sm text-gray-600">${formatFileLabel(file.fileName)}</p>
                    <p class="font-semibold text-gray-900 leading-tight">${file.fileName}</p>
                    <p class="text-sm text-gray-700 mt-1">Peak: <span class="font-semibold">${file.peakPressure} mmHg</span></p>
                    <p class="text-sm text-gray-700">Contact: <span class="font-semibold">${file.contactArea}%</span></p>
                </div>
                ${badge}
            </div>
            <div class="flex items-center gap-3">
                <div class="flex-1">${renderMiniMatrix(file.smallMatrix)}</div>
            </div>
            <div class="flex gap-2">
                <button class="viewHeatmapBtn flex-1 bg-blue-600 text-white py-2 px-3 rounded-md hover:bg-blue-700 transition"
                        data-patient-id="${patientId}" data-file-name="${file.fileName}">
                    View heatmap
                </button>
                <button class="commentBtn px-3 py-2 border border-gray-300 rounded-md text-gray-800 hover:bg-gray-100 transition"
                        data-patient-id="${patientId}" data-file-name="${file.fileName}">
                    Comment
                </button>
            </div>
        </div>
    `;
}

function formatFileLabel(fileName) {
    if (!fileName) return 'Unknown file';
    const match = fileName.match(/^[^_]+_(\d{8})/);
    if (match) {
        const raw = match[1];
        const formatted = `${raw.substring(0, 4)}-${raw.substring(4, 6)}-${raw.substring(6, 8)}`;
        return `Recorded ${formatted}`;
    }
    return 'Data file';
}

function renderMiniMatrix(matrix) {
    if (!Array.isArray(matrix) || matrix.length === 0) {
        return '<div class="text-xs text-gray-500 italic">No preview</div>';
    }

    const rows = matrix
        .map(row => {
            const cells = row
                .map(val => `<span class="w-3 h-3 block" style="background:${getColorForValue(val)}"></span>`)
                .join('');
            return `<div class="flex">${cells}</div>`;
        })
        .join('');

    return `<div class="inline-block rounded-md overflow-hidden border border-gray-200 shadow-inner">${rows}</div>`;
}

function getColorForValue(pressure) {
    if (pressure < 20) return '#0f172a';
    if (pressure < 40) return '#1e3a8a';
    if (pressure < 60) return '#06b6d4';
    if (pressure < 80) return '#2dd4bf';
    if (pressure < 100) return '#bef264';
    if (pressure < 120) return '#f59e0b';
    if (pressure < 150) return '#f97316';
    if (pressure < 180) return '#ea580c';
    if (pressure < 220) return '#b91c1c';
    return '#7f1d1d';
}

function openHeatmap(patientId, fileName) {
    selectedPatientId = patientId;
    selectedFileName = fileName;
    $('#commentStatus').text('').removeClass('text-red-600 text-green-600');
    $('#commentTextArea').val('');
    $('#modalTitle').text(`Patient ${patientId} • ${fileName}`);
    $('#heatmapModalBody').html('<div class="p-4 text-gray-600">Loading heatmap...</div>');
    $('#heatmapModal').removeClass('hidden');

    $.get('/Home/GetHeatmapPartial', { patientId, fileName })
        .done(function (html) {
            $('#heatmapModalBody').html(html);
            setTimeout(initializeHeatmapControls, 0);
        })
        .fail(function () {
            $('#heatmapModalBody').html('<div class="p-4 bg-red-50 text-red-700 rounded">Failed to load heatmap.</div>');
        });
}

function closeHeatmapModal() {
    $('#heatmapModal').addClass('hidden');
}

function setCommentStatus(message, isError) {
    const el = $('#commentStatus');
    el.text(message || '');
    el.removeClass('text-red-600 text-green-600');
    if (!message) return;
    el.addClass(isError ? 'text-red-600' : 'text-green-600');
}

function showCommentsModal() {
    $('#commentsContainer').html('<div class="p-4 text-gray-600">Loading comments...</div>');
    $('#commentsModal').removeClass('hidden');

    $.get('/Home/GetAllComments')
        .done(function (data) {
            if (!Array.isArray(data) || data.length === 0) {
                $('#commentsContainer').html('<div class="p-4 text-gray-600">No comments yet.</div>');
                return;
            }

            const html = data
                .map(item => {
                    const ts = item.timestamp ? new Date(item.timestamp) : null;
                    const when = ts ? ts.toLocaleString() : 'Unknown time';
                    return `
                        <div class="py-3 px-2 border-b border-gray-100 last:border-b-0">
                            <p class="text-sm text-gray-800"><span class="font-semibold">Patient:</span> ${item.patientId}</p>
                            <p class="text-sm text-gray-800"><span class="font-semibold">File:</span> ${item.fileName}</p>
                            <p class="text-sm text-gray-600">${when}</p>
                            <p class="mt-1 text-gray-900">${item.comment}</p>
                        </div>
                    `;
                })
                .join('');

            $('#commentsContainer').html(`<div class="divide-y divide-gray-100">${html}</div>`);
        })
        .fail(function () {
            $('#commentsContainer').html('<div class="p-4 bg-red-50 text-red-700 rounded">Failed to load comments.</div>');
        });
}

function closeCommentsModal() {
    $('#commentsModal').addClass('hidden');
}

function populateMedPatientsSelect() {
    const select = $('#medPatientSelect');
    if (!select.length) return;

    select.empty();
    select.append('<option value=\"\">Select patient</option>');

    patientDataCache.forEach(p => {
        select.append(`<option value=\"${p.patientId}\">${p.patientId}</option>`);
    });

    const defaultId = selectedPatientId || '';
    if (defaultId) {
        select.val(defaultId);
        $('#medPatientIdInput').val(defaultId);
    }
}

function hideMedsModal() {
    $('#medsModal').addClass('hidden');
}

function applyDarkMode(enabled) {
    $('body').toggleClass('dark-mode', enabled);
    $('#toggleDarkMode').text(enabled ? 'Light Mode' : ' Dark Mode');
}

function initializeHeatmapControls() {
    const slider = document.getElementById('heatmapFrameSlider');
    const peakLabel = document.getElementById('heatmapPeakValue');
    const areaLabel = document.getElementById('heatmapAreaValue');
    const badge = document.getElementById('heatmapAlertBadge');
    const frameLabel = document.getElementById('heatmapFrameLabel');
    const table = document.querySelector('#heatmapContainer table');

    if (!slider || !table || !Array.isArray(window.frames) || !window.frames.length) return;

    const totalFrames = window.totalFrames || window.frames.length;
    const cells = Array.from(table.querySelectorAll('td'));
    const MIN_CONTACT = 10;
    const ALERT_THRESHOLD = 200;

    slider.min = 0;
    slider.max = Math.max(totalFrames - 1, 0);
    slider.value = window.currentFrame || 0;
    slider.disabled = totalFrames <= 1;

    function updateFrameLabel(idx) {
        if (!frameLabel) return;
        const safeTotal = Math.max(totalFrames, 1);
        const humanIndex = Math.min(idx + 1, safeTotal);
        frameLabel.textContent = `Frame ${humanIndex} / ${safeTotal}`;
    }

    function updateMetrics(frame) {
        let peak = 0;
        let contact = 0;
        let total = 0;

        frame.forEach(row => {
            row.forEach(val => {
                const v = Number(val) || 0;
                total++;
                if (v > peak) peak = v;
                if (v >= MIN_CONTACT) contact++;
            });
        });

        const areaPercent = total ? Math.round((contact / total) * 100) : 0;
        if (peakLabel) peakLabel.textContent = `${peak} mmHg`;
        if (areaLabel) areaLabel.textContent = `${areaPercent}%`;

        if (badge) {
            const isAlert = peak >= ALERT_THRESHOLD;
            badge.textContent = isAlert ? 'High Risk' : 'Nominal';
            badge.classList.remove('bg-red-100', 'text-red-700', 'bg-emerald-100', 'text-emerald-700');
            badge.classList.add(isAlert ? 'bg-red-100' : 'bg-emerald-100', isAlert ? 'text-red-700' : 'text-emerald-700');
        }
    }

    function renderFrame(idx) {
        const frame = window.frames[idx];
        if (!frame || !cells.length) return;

        let cellPointer = 0;
        for (let r = 0; r < frame.length; r++) {
            const row = frame[r];
            for (let c = 0; c < row.length; c++) {
                const cell = cells[cellPointer++];
                if (!cell) continue;
                cell.style.backgroundColor = getColorForValue(row[c] || 0);
            }
        }

        updateFrameLabel(idx);
        updateMetrics(frame);
    }

    slider.oninput = function (event) {
        const idx = parseInt(event.target.value || '0', 10) || 0;
        window.currentFrame = idx;
        renderFrame(idx);
    };

    renderFrame(window.currentFrame || 0);
}

</script>
}
