@model GrapheneTrace.Models.HeatmapData

@{
    var showInsights = ViewData["ShowHeatmapInsights"] as bool? ?? false;
    var safeTotalFrames = Model.TotalFrames > 0 ? Model.TotalFrames : 1;
    var sliderMax = Model.TotalFrames > 0 ? Model.TotalFrames - 1 : 0;
    var frameLabel = Math.Min(Model.CurrentFrame + 1, safeTotalFrames);
    var layoutClass = showInsights ? "flex flex-col md:flex-row gap-6" : string.Empty;
    var matrixWrapperClass = showInsights ? "flex-1 bg-slate-900 rounded-2xl p-4 shadow-inner" : string.Empty;
    var gridClass = showInsights ? "overflow-hidden rounded-xl border border-slate-800" : string.Empty;
}

<div id="heatmapContainer" class="@layoutClass">
    <div class="@matrixWrapperClass">
        <div id="heatmapGrid" class="@gridClass">
            <table class="full-heatmap-table" style="border-collapse:collapse;">
                @for (int i = 0; i < Model.PressureMatrix.Count; i++)
                {
                    <tr>
                        @for (int j = 0; j < Model.PressureMatrix[i].Count; j++)
                        {
                            var val = Model.PressureMatrix[i][j];
                            string color = GetColorForValue(val);
                            <td style="width:10px;height:10px;background-color:@color;"></td>
                        }
                    </tr>
                }
            </table>
        </div>
    </div>

    @if (showInsights)
    {
        <div class="w-full md:w-64 space-y-4">
            <div class="bg-white rounded-2xl p-4 shadow border border-slate-200">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Peak Pressure</p>
                <p id="heatmapPeakValue" class="text-3xl font-bold text-slate-900 mt-1">@Model.PeakPressureIndex mmHg</p>

                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mt-4">Contact Area</p>
                <p id="heatmapAreaValue" class="text-2xl font-semibold text-slate-900">@Model.ContactAreaPercent%</p>

                <div class="mt-4">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Status</p>
                    <span id="heatmapAlertBadge"
                          class="mt-1 inline-flex items-center px-3 py-1 rounded-full text-xs font-medium @(Model.IsAlertGenerated ? "bg-red-100 text-red-700" : "bg-emerald-100 text-emerald-700")">
                        @(Model.IsAlertGenerated ? "High Risk" : "Nominal")
                    </span>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-4 shadow border border-slate-200">
                <div class="flex justify-between text-sm text-slate-600">
                    <span>Time Frame</span>
                    <span id="heatmapFrameLabel">Frame @frameLabel / @safeTotalFrames</span>
                </div>
                <input id="heatmapFrameSlider"
                       type="range"
                       min="0"
                       max="@sliderMax"
                       value="@Model.CurrentFrame"
                       class="w-full mt-3 accent-blue-500"
                       @(Model.TotalFrames <= 1 ? "disabled=\"disabled\"" : string.Empty) />
                <p class="text-xs text-slate-500 mt-2">Drag to scrub through the recording.</p>
            </div>
        </div>
    }
</div>

<script>
    // Expose all frames + basic info to JavaScript so slider & charts can use them
    window.frames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Frames));
    window.totalFrames = @Model.TotalFrames;
    window.currentFrame = @Model.CurrentFrame;
</script>

@functions {
    // Same colour scale you were using before
    private string GetColorForValue(int pressure)
    {
        if (pressure < 20) return "#0f172a"; // dark blue
        if (pressure < 40) return "#1e3a8a";
        if (pressure < 60) return "#06b6d4";
        if (pressure < 80) return "#2dd4bf";
        if (pressure < 100) return "#bef264";
        if (pressure < 120) return "#f59e0b";
        if (pressure < 150) return "#f97316";
        if (pressure < 180) return "#ea580c";
        if (pressure < 220) return "#b91c1c";
        return "#7f1d1d"; // dark red
    }
}
