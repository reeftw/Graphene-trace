@model GrapheneTrace.ViewModels.MedicationViewModel

@{
    ViewData["Title"] = "Medications";
}

<div class="max-w-2xl mx-auto mt-10 bg-white shadow-lg rounded-xl p-8">

    <h2 class="text-2xl font-semibold mb-6">Medications for Patient @Model.PatientId</h2>

    @if (Model.Medications.Count == 0)
    {
        <p class="text-gray-500">No medications have been prescribed.</p>
    }
    else
    {
        <ul class="list-disc ml-6 space-y-2">
            @foreach (var med in Model.Medications)
            {
                <li class="text-gray-700">@med</li>
            }
        </ul>
    }

    <div class="mt-6">
        <a href="/Home/Patient?patientId=@Model.PatientId"
           class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
            Back to Dashboard
        </a>
    </div>
</div>
